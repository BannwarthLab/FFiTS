Bootstrap: docker
From: rockylinux:9

%post
    # Update system and install necessary packages
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Europe/Berlin

    # Update package index
    dnf -y update

    # Install development tools and utilities
    dnf groupinstall -y "Development Tools"
    dnf install -y wget git gcc-gfortran python3-pip

    # Enable EPEL repository for additional packages
    dnf install -y epel-release

    # Install Python
    dnf install -y python3.11 python3.11-devel python3.11-pip

    # install xtb
    wget https://github.com/grimme-lab/xtb/releases/download/v6.7.1/xtb-6.7.1-linux-x86_64.tar.xz
    tar -xvf xtb-6.7.1-linux-x86_64.tar.xz
    chmod 777 -R xtb-dist

    # Clean up cache to reduce image size
    dnf clean all
    rm -rf /var/cache/dnf


%environment
    # Add local Python binaries to PATH
    export PATH=~/.local/bin:$PATH
    export XTBEXE=/xtb-dist/bin/
    export PATH=$XTBEXE:$PATH 